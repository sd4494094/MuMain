<rml>
<head>
    <title>Stat advisor</title>
    <link type="text/rcss" href="base.rcss"/>
    <link type="text/rcss" href="docked_panel_frame.rcss"/>
    <link type="text/rcss" href="npc_dialogue.rcss"/>
    <link type="text/rcss" href="stat_advisor.rcss"/>
</head>
<body>
<div id="panel" data-model="stat_advisor" data-style---text-px="text_px + 'px'"
     data-class-home="page == 0" data-class-reset="page == 1" data-class-form="page == 2 || page == 3">
    <div class="frame-piece frame-top"></div><div class="frame-piece frame-left"></div>
    <div class="frame-piece frame-right"></div><div class="frame-piece frame-bottom"></div>
    <span id="title" class="sharp-text" data-style-font-size="text_px + 'px'">{{title}}</span>
    <div id="advisor-body" class="scroll-pane sharp-text" data-style-font-size="text_px + 'px'">
        <div class="advisor-message">{{message}}</div>
    </div>
    <div class="nd-divider"></div>
    <div id="advisor-options" class="scroll-pane sharp-text" data-style-font-size="text_px + 'px'">
        <div class="advisor-home" data-if="page == 0">
            <button class="nd-answer-row advisor-action" data-class-disabled="pending" data-event-click="advisor_action(1)">1. {{reset}}</button>
            <button class="nd-answer-row advisor-action" data-class-disabled="pending" data-event-click="advisor_action(3)">2. {{allocate}}</button>
        </div>
        <div class="advisor-form" data-if="page == 2 || page == 3">
            <div class="advisor-balance">{{available}}</div>
            <div class="advisor-row advisor-header">
                <span>{{attribute_label}}</span><span>{{current_label}}</span><span>{{increase_label}}</span><span>{{result_label}}</span>
            </div>
            <div class="advisor-row" data-for="row : rows">
                <span>{{row.name}}</span><span>{{row.current}}</span>
                <input class="text-field text-field--numeric advisor-input" type="text" maxlength="5"
                       data-value="row.amount" data-class-disabled="pending || page == 3"/>
                <span>{{row.result}}</span>
            </div>
            <div class="advisor-summary">{{total}}</div>
            <div class="advisor-summary">{{remaining}}</div>
        </div>
    </div>
    <div class="advisor-feedback sharp-text" data-style-font-size="text_px + 'px'">{{feedback}}</div>
    <div class="advisor-footer sharp-text" data-style-font-size="text_px + 'px'">
        <button class="nd-answer-row" data-if="page == 1" data-class-disabled="pending || !can_confirm" data-event-click="advisor_action(2)">{{confirm_reset}}</button>
        <button class="nd-answer-row" data-if="page == 2" data-class-disabled="pending || !valid" data-event-click="advisor_action(4)">{{next}}</button>
        <button class="nd-answer-row" data-if="page == 3" data-class-disabled="pending || !can_confirm" data-event-click="advisor_action(5)">{{confirm_allocation}}</button>
        <button class="nd-answer-row" data-if="page == 2" data-class-disabled="pending" data-event-click="advisor_action(8)">{{clear}}</button>
        <button class="nd-answer-row" data-if="page == 1 || page == 2" data-class-disabled="pending" data-event-click="advisor_action(6)">{{back}}</button>
        <button class="nd-answer-row" data-if="page == 3" data-class-disabled="pending" data-event-click="advisor_action(3)">{{back}}</button>

    </div>
    <div id="btn_exit" class="modern-icon-btn-px nd-btn-exit" data-attr-data-hint="leave" data-event-click="advisor_action(7)"><span class="btn-exit-label modern-icon-btn-glyph-px">×</span></div>
    <div id="frame_corner_close" data-event-click="advisor_action(7)"></div>
</div>
</body>
</rml>
