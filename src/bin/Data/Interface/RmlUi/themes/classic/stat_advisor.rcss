/* A centered fixed-size advisor panel, using global dp auto-fit and theme controls.
   The body scrolls; close/confirm actions always remain outside the scroll area. */
#panel {
    width: 520dp;
    height: 400dp;
    box-sizing: border-box;
    padding: 16dp;
    background-color: #201b15;
    border: 2dp #8c714a;
    color: token(text-primary);
    font-family: "token(font-body)";
    font-size: 14dp;
    pointer-events: auto;
}
.advisor-title { height: 25dp; font-weight: bold; color: token(accent-gold); }
#advisor-body { height: 260dp; overflow-y: auto; overflow-x: hidden; }
.advisor-message { white-space: pre-wrap; word-break: break-word; margin-bottom: 12dp; }
.advisor-home { display: flex; flex-direction: column; align-items: center; }
.advisor-home > .btn { position: relative; }
.advisor-action { margin-bottom: 12dp; }
.advisor-row { display: flex; align-items: center; height: 32dp; width: 100%; box-sizing: border-box; }
.advisor-row > span { width: 25%; min-width: 0; text-align: center; overflow: hidden; }
.advisor-input { width: 23%; margin-left: 1%; margin-right: 1%; height: 25dp; box-sizing: border-box; }
.advisor-header { font-size: 12dp; color: token(accent-gold); }
.advisor-balance { margin-bottom: 6dp; }
.advisor-summary { text-align: right; margin-top: 5dp; }
.advisor-feedback { height: 30dp; font-size: 12dp; color: #ffb060; white-space: normal; word-break: break-word; }
.advisor-footer { display: flex; justify-content: center; align-items: center; height: 42dp; }
.advisor-footer > .btn { position: relative; margin-left: 3dp; margin-right: 3dp; min-width: 92dp; }
