/* The same fixed native NPC frame and typography as npc_dialogue. */
#panel { pointer-events: auto; color: token(text-narrative); }
#npc_lines_container { height: calc(109px * var(--root-scale)); overflow-y: auto; overflow-x: hidden; }
#npc_lines_container .nd-line { white-space: pre-wrap; word-break: break-word; }
#answers_container { height: calc(174px * var(--root-scale)); overflow-y: auto; overflow-x: hidden; }
.nd-answer-row { min-height: calc(18px * var(--root-scale)); white-space: normal; word-break: break-word; }
.nd-answer-row.disabled { color: token(text-disabled); }
.npc-option-details { display: none; }
#panel.warp #npc_lines_container { display: none; }
#warp_preview { display: none; }
#panel.warp #warp_preview { display: block; position: absolute; top: 48px; left: 15px; right: 15px; height: calc(60px * var(--root-scale)); overflow-y: auto; overflow-x: hidden; white-space: normal; word-break: break-word; line-height: calc(14px * var(--root-scale)); }
#warp_preview_name, #warp_preview_details { display: block; width: 100%; box-sizing: border-box; white-space: pre-wrap; word-break: break-word; }
#warp_preview_details { color: token(accent-gold); }
#panel.warp .nd-divider { top: 108px; }
#panel.warp #answers_container { top: 131px; height: calc(246px * var(--root-scale)); }
#panel.warp .nd-answer-row { white-space: nowrap; overflow-x: hidden; }
